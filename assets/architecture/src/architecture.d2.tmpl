# Harness² architecture diagram (template).
# Rendered by assets/architecture/src/render.py into light and dark SVGs.
# {{name}} placeholders are filled from the palette in render.py.

direction: down
grid-columns: 3
grid-gap: 150

classes: {
  group: {
    style: {
      border-radius: 14
      stroke-width: 2
      font-size: 22
      bold: true
    }
  }
  box: {
    width: 230
    style: {
      border-radius: 10
      fill: "{{box}}"
      stroke: "{{box_stroke}}"
      font-color: "{{text}}"
      font-size: 17
    }
  }
}

style: {
  fill: "{{bg}}"
}

(** -> **)[*]: {
  style.stroke: "{{edge}}"
  style.font-color: "{{edge_text}}"
  style.font-size: 15
}

(** <-> **)[*]: {
  style.stroke: "{{edge}}"
  style.font-color: "{{edge_text}}"
  style.font-size: 15
}

cli: "CLI  ·  harness2-*" {
  class: group
  style.fill: "{{cli_bg}}"
  style.stroke: "{{cli_stroke}}"
  style.font-color: "{{text}}"
  icon: {{icons}}/gnubash.svg
  grid-columns: 1
  grid-gap: 24

  setup: "harness2-setup / -check\ninstall + preflight" {class: box}
  run: "harness2\nrefinement sweep" {class: box}
  demo: "harness2-demo\nlocal, no credentials" {class: box}
  judge: "harness2-judge / -report\ngrade + summarize" {class: box}
}

core: "harness2.core  ·  the method (benchmark-independent)" {
  class: group
  style.fill: "{{core_bg}}"
  style.stroke: "{{core_stroke}}"
  style.font-color: "{{text}}"
  icon: {{icons}}/python.svg

  grid-columns: 1
  grid-gap: 80

  inputs: "" {
    style.fill: transparent
    style.stroke: transparent
    grid-rows: 1
    grid-gap: 40
    schedule: "schedule\nsweep → domain → task\nk shared base rollouts" {class: box}
    tree: "tree\nc1..c8 harness components" {class: box}
    context: "context\nevidence tree\n(no grader verdicts)" {class: box}
  }

  task: "Task-level recursion  ·  Propose–Probe–Compose" {
    class: group
    style.fill: "{{inner_bg}}"
    style.stroke: "{{core_stroke}}"
    style.font-color: "{{text}}"
    style.font-size: 18
    grid-rows: 1
    grid-gap: 40

    propose: "① Propose\nimprover edits (INV / DOM)" {class: box}
    probe: "② Probe\nrun candidate harnesses" {class: box}
    compose: "③ Compose\nmerge behavioral contrasts" {class: box}
  }

  outputs: "" {
    style.fill: transparent
    style.stroke: transparent
    grid-rows: 1
    grid-gap: 120
    library: "MemoryConnector\nper-domain experience\n= improvement harness\nscope: per run |\nHARNESS2_MEMORY_SCOPE" {
      class: box
      shape: cylinder
      width: 300
      height: 170
    }
    selection: "selection\nblind pick of a final\n+ reflection" {class: box}
    routes: "model connector  ·  config.ROLES\nrole → route table\nexecutor: oc · cx\nimprover: opencode · claude_cli\njudge: jb · lab · wb" {
      class: box
      width: 290
    }
  }

  impls: "" {
    style.fill: transparent
    style.stroke: transparent
    grid-rows: 1
    grid-gap: 40
    file: "FileConnector (default)\nfiles under the library root" {class: box}
    plug: "pluggable connector\nentry point · module:Attr" {
      class: box
      style.stroke-dash: 4
    }
  }
}

exec: "Execution & evaluation" {
  class: group
  style.fill: "{{bg}}"
  style.stroke: "{{box_stroke}}"
  style.stroke-dash: 4
  style.font-color: "{{text}}"
  grid-columns: 1
  grid-gap: 30

  intake: "task intake  ·  external tasks" {
    class: group
    style.fill: "{{bench_bg}}"
    style.stroke: "{{bench_stroke}}"
    style.stroke-dash: 4
    style.font-color: "{{text}}"
    grid-rows: 2
    grid-columns: 2
    horizontal-gap: 120
    vertical-gap: 60

    connector: "TaskConnector\nlocal | entry point | module:Attr" {class: box}
    normalizer: "normalizer\nRawTask → TaskSpec\n(schema check, 1 retry)" {class: box}
    ext: "external task connector\nentry point | module:Attr" {class: box; width: 300}
  }

  bench: "benchmarks  ·  adapters" {
    label.near: top-left
    class: group
    style.fill: "{{bench_bg}}"
    style.stroke: "{{bench_stroke}}"
    style.font-color: "{{text}}"
    grid-rows: 1
    grid-gap: 16

    jb: "JobBench\nprofessional work" {class: box; width: 190}
    lab: "LAB\nlegal work" {class: box; width: 190}
    wb: "WorkBuddy-Bench\noffice · web · code" {
      class: box
      width: 190
      height: 130
      label.near: top-center
      icon.near: bottom-center
      icon: {{icons}}/docker.svg
    }
    intake: "IntakeAdapter\nprivate_criteria → judge only" {class: box; width: 250}
  }

  substrate: "substrate  ·  task executors" {
    label.near: top-left
    class: group
    style.fill: "{{sub_bg}}"
    style.stroke: "{{sub_stroke}}"
    style.font-color: "{{text}}"
    grid-rows: 1
    grid-gap: 16

    oc: "OpenCode\ndefault executor" {
      class: box
      width: 290
      height: 130
      label.near: top-center
      icon.near: bottom-center
      icon: {{icons}}/bun.svg
    }
    cx: "Codex CLI\n--substrate cx" {
      class: box
      width: 290
      height: 130
      label.near: top-center
      icon.near: bottom-center
      icon: {{icons}}/openai.svg
    }
    ws: "" {
      style.fill: transparent
      style.stroke: transparent
      direction: right
      worktree: "git worktree per rollout\nchanges.diff (policy exclude)" {class: box}
      source: "source repo\napply chosen diff\n(after policy guard)" {class: box}
    }
  }

  models: "Vertex AI  ·  models" {
    class: group
    style.fill: "{{model_bg}}"
    style.stroke: "{{model_stroke}}"
    style.font-color: "{{text}}"
    icon: {{icons}}/googlecloud.svg
    grid-rows: 1
    grid-gap: 16

    gemini: "Gemini\nexecutor · judge" {
      class: box
      width: 290
      height: 130
      label.near: top-center
      icon.near: bottom-center
      icon: {{icons}}/googlegemini.svg
    }
    claude: "Claude or Gemini\nimprover" {
      class: box
      width: 290
      height: 130
      label.near: top-center
      icon.near: bottom-center
      icon: {{icons}}/anthropic.svg
    }
  }

  runs: "runs/\nsummaries · deliverables · adopted harnesses · scores" {
    shape: cylinder
    width: 620
    style.fill: "{{box}}"
    style.stroke: "{{box_stroke}}"
    style.font-color: "{{text}}"
    style.font-size: 17
  }
}


cli.run -> core.inputs.schedule: "run"
core.inputs.schedule -> core.task: "k base rollouts"
core.inputs.tree -> core.task: "edited surface" {style.stroke-dash: 4}
core.inputs.context -> core.task: "evidence" {style.stroke-dash: 4}
core.task.propose -> core.task.probe
core.task.probe -> core.task.compose
core.task -> core.outputs.selection: "k finals"
core.outputs.selection -> core.outputs.library: "adopt +\nlesson"
core.outputs.library -> core.task: "guides the next task\n(harnessing-level recursion)\n+ recall → always-on memory\n(HARNESS2_MEMORY_RECALL=1)" {
  style.stroke: "{{accent}}"
  style.stroke-width: 3
  style.font-color: "{{accent_text}}"
}
core.outputs.library -> core.impls.file: "default" {style.stroke-dash: 4}
core.outputs.library -> core.impls.plug: "HARNESS2_MEMORY_CONNECTOR\nname, entry point or module:Attr" {style.stroke-dash: 4}

core -> exec: "rollouts ·\nimprover calls" {style.stroke-width: 3}
exec.bench -> exec.substrate: "launch rollout"
exec.substrate -> exec.models: "model calls"
exec.models -> exec.runs: "outputs"
core.outputs.routes -> exec.substrate.oc: {style.stroke-dash: 4}
core.outputs.routes -> exec.models: {style.stroke-dash: 4}

exec.intake.connector -> exec.intake.normalizer: "RawTask"
exec.intake.normalizer -> exec.bench.intake: "TaskSpec"
exec.bench.intake -> exec.substrate
core.task -> exec.intake.connector: "deliver chosen\nrun's output" {style.stroke-dash: 4}
exec.intake.ext <-> exec.intake.connector: "claim task ·\nreport"
exec.bench.intake -> exec.substrate.ws.worktree: "rollout"
exec.substrate.ws.worktree -> exec.substrate.ws.source: "apply\nchosen diff" {style.stroke-dash: 4}
